{
  "expo": {
    "name": "Cricket Amigo",
    "slug": "cricket-amigo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cricketamigo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#052e16",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cricketamigo.app"
    },
    "android": {
      "package": "com.cricketamigo.app",
      "adaptiveIcon": {
        "backgroundColor": "#052e16",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "cricketamigo",
              "host": "*",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "cricketamigo.test",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#052e16"
        }
      ],
      "expo-video",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Cricket Amigo to record your training videos.",
          "microphonePermission": "Allow Cricket Amigo to record audio with your training videos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Cricket Amigo to save training clips to your gallery.",
          "savePhotosPermission": "Allow Cricket Amigo to save training clips to your gallery.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://cricketamigo.test"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}